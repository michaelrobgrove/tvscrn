# tvscrn Configuration
# Copy this file to .env and edit as needed

# Database URL (leave empty for SQLite, set for MariaDB)
# DB_URL=mariadb+pymysql://user:password@localhost:3306/tvscrn

# Flask secret key (generate a random one for production)
# SECRET_KEY=your-secret-key-here

# SQLite database path (used when DB_URL is empty)
# DB_PATH=/app/data/devices.db
